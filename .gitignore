# Environment Variables & Local Secrets
.env
.env*
.env.*
!.env.example

# Node modules & package manager stores
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/

# SQLite & Runtime Database Artefacts
*.db
*.db-wal
*.db-shm
**/*.db
**/*.db-wal
**/*.db-shm

# Persistent session, telemetry & storage data
config/sessions/*
!config/sessions/.gitkeep
config/storages/*
!config/storages/.gitkeep
config/audit/*
!config/audit/.gitkeep
config/patch/*
!config/patch/.gitkeep
config/prompt-library/
config/profiles/web/.dsh-market/
config/profiles/.dsh-market/
config/.anonymous-user-id
config/patch*.tmp.yaml
config/*.tmp.yaml
config/models.cache.json
config/sync_status.json
config/settings.yaml
!config/settings.default.yaml

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testinstall/
installtest/
pnpm-debug.log*

# Workspace ephemeral outputs
workspaces/*
!workspaces/.gitkeep
!workspaces/cases/
workspaces/cases/*
!workspaces/cases/.gitkeep
