# ==============================================================================
# DeepSeek Harness (DSH) Environment Configuration (.env)
# Restrict file permissions: chmod 0600 .env
# ==============================================================================

# --- [OPTIONAL] Network Port Configuration ---
# Host port bound to 127.0.0.1 for the DSH Web UI (defaults to 3080).
DSH_PORT=3080

# --- [CONDITIONALLY MANDATORY] LLM Provider Credentials ---
# NOTE: At least ONE model provider key (GEMINI_API_KEY or OPENROUTER_API_KEY)
# is REQUIRED for agents to generate reasoning, plan tasks, or execute tools.

# Google AI Studio API Key (for Gemini 3.7 / 2.5 Pro & Flash with thought signatures)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenRouter API Key (for DeepSeek V3, DeepSeek R1, Claude 3.5/3.7, GPT-4o)
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=

# --- [OPTIONAL] Web Search Engine Credentials ---
# The built-in zero-key search fallback (DuckDuckGo) runs automatically without keys.
# To optionally route through premium web search APIs via @liustack/modsearch:
# • Tavily (1,000 free searches/month, no card): https://tavily.com
TAVILY_API_KEY=
# • Firecrawl (1,000 free credits/month, no card): https://firecrawl.dev
FIRECRAWL_API_KEY=
# • Exa ($10 recurring monthly credit, no card): https://exa.ai
EXA_API_KEY=

# --- [OPTIONAL] Tool & MCP Server Credentials ---
# GitHub Personal Access Token (fine-grained PAT with repo contents/PR permissions)
# Required ONLY if using the 'github' MCP tool server.
# Create a token at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- [REQUIRED] Arize Phoenix Telemetry & Observability UI ---
# Authentication is enabled by default. The installer generates independent signing,
# bootstrap-admin, and initial-password secrets. Replace PHOENIX_API_KEY with a scoped
# Phoenix system ingestion key after first login, then remove PHOENIX_ADMIN_SECRET.
PHOENIX_ENABLE_AUTH=true
PHOENIX_SECRET=
PHOENIX_ADMIN_SECRET=
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
PHOENIX_API_KEY=
# Optional scoped Phoenix system key used only by telemetry-gateway. If blank, the gateway
# falls back to PHOENIX_API_KEY for bootstrap compatibility; replace it after first login.
PHOENIX_INGEST_TOKEN=

# --- [AUTO-GENERATED / INTERNAL SECRET] Human Approval Gate Signing ---
# NOTE: This is NOT an external API key! No registration or third-party account is needed.
# It is an internal cryptographic random string (min 16 chars) used on your local machine
# to sign human approval tokens when resuming gated persona workflows (./dsh.sh approve).
# • Standard chat and MCP tools work normally without it.
# • The installer (install_dsh.sh) generates this automatically.
# • To generate manually: openssl rand -hex 32
DSH_APPROVAL_SECRET=

# --- [AUTO-GENERATED / INTERNAL SECRET] BYOK Encrypted Vault Master Key ---
# Master encryption secret (>=32 chars) for AES-256-GCM user keystore encryption.
# Generated automatically by install_dsh.sh.
# • To generate manually: openssl rand -hex 32
DSH_VAULT_MASTER_KEY=

# --- [AUTO-GENERATED / INTERNAL SECRET] Lifecycle Restart CSRF Token ---
# Required for the loopback-only lifecycle restart endpoint.
# Generated automatically by install_dsh.sh.
DSH_RESTART_CSRF_TOKEN=

# --- [AUTO-GENERATED / INTERNAL SECRET] Audit Trail Integrity Key ---
# HMAC key used to detect offline edits and reordering inside the GRC JSONL chain.
# Generated automatically by install_dsh.sh; keep it separate from the audit volume.
# • To generate manually: openssl rand -hex 32
DSH_AUDIT_INTEGRITY_KEY=

# Bearer credential accepted only by the internal audit-writer ingestion endpoint.
# It cannot be reused to compute or alter audit HMACs.
DSH_AUDIT_WRITER_TOKEN=

# HMAC key for short-lived, one-time command-execution capabilities (minimum 32 bytes).
# Generate independently from audit and application secrets: openssl rand -hex 32
DSH_EXECUTOR_CAPABILITY_KEY=

# Legacy in-process shell commands are not an OS-level tenant boundary. Leave this off;
# the standard and sandbox Compose profiles use the isolated executor instead.
DSH_ALLOW_UNCONFINED_SHELL=0
