# DeepSeek Harness Port Configuration
DSH_PORT=3080

# Google AI Studio API Key (for Gemini 2.5 / 1.5 Pro & Flash)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenRouter API Key (for DeepSeek V3, Claude 3.5 Sonnet, GPT-4o)
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=

# GitHub Personal Access Token (for GitHub MCP server operations)
# Create a token at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Arize Phoenix Telemetry & Observability (Optional UI Authentication)
# By default, Phoenix binds to localhost (127.0.0.1:6006) without auth.
# To enforce authentication on Phoenix UI, set PHOENIX_ENABLE_AUTH=true and supply a secret.
PHOENIX_ENABLE_AUTH=false
PHOENIX_SECRET=
PHOENIX_API_KEY=

# Workflow Governance & Human Approval Gate Secret
# Required for signing and verifying out-of-process workflow resume tokens (min 16 chars)
DSH_APPROVAL_SECRET=
