# DeepSeek Harness Port Configuration
DSH_PORT=3080

# Google AI Studio API Key (for Gemini 3.7 Flash & Gemini 3.1 Pro)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourActualGoogleKeyHere

# OpenRouter API Key (for DeepSeek V3, Claude 3.5 Sonnet, GPT-4o)
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-YourActualOpenRouterKeyHere

# GitHub Personal Access Token (for GitHub MCP server operations)
# Create a token at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YourGitHubTokenHere

# Arize Phoenix Telemetry & Observability API Key (Optional: for Phoenix Cloud / Auth)
# Get yours at: https://app.phoenix.arize.com/
PHOENIX_API_KEY=
PHOENIX_SECRET=
